# Poort waarop Wolsels bereikbaar is (http://localhost:8080)
WOLSELS_PORT=8080

# Maximaal aantal soorten wol in één mengsel
MAX_BLEND_COMPONENTS=6

# Images: lokaal bouwen vanuit de broncode-repo's, of een registry gebruiken
REGISTRY=wolsels
TAG=latest
BACKEND_CONTEXT=../wolsels-backend
FRONTEND_CONTEXT=../wolsels-frontend

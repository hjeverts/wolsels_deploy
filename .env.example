# Adres en poort waarop de container luistert. 127.0.0.1 = alleen voor de nginx op de server;
# zet op 0.0.0.0 om Wolsels zonder host-nginx direct bereikbaar te maken.
WOLSELS_BIND=127.0.0.1
WOLSELS_PORT=8080

# Maximaal aantal soorten wol in één mengsel
MAX_BLEND_COMPONENTS=6

# Images: lokaal bouwen vanuit de broncode-repo's, of een registry gebruiken
REGISTRY=wolsels
TAG=latest
BACKEND_CONTEXT=../wolsels-backend
FRONTEND_CONTEXT=../wolsels-frontend

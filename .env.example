# Copy to .env and adjust. .env is in .gitignore: feel free to put passwords here,
# but make sure only you can read the file (chmod 600 .env).

# --- General ---
# Public URL, used for the links in emails
WOLSELS_PUBLIC_URL=https://wolsels.example.nl
# Port (on 127.0.0.1) Wolsels listens on; must match proxy_pass in nginx/wolsels.conf
WOLSELS_PORT=8083
# Maximum number of wools in one blend
MAX_BLEND_COMPONENTS=6

# --- Accounts and security ---
# May new users create an account themselves? The very first account is always allowed, and with a
# household invitation link it also works when this is set to false.
ALLOW_REGISTRATION=true
# This account always becomes administrator at startup (only needed to restore access).
# Normally the first account is administrator and administrators can make others administrator.
ADMIN_EMAIL=
# After this many failed attempts (password or 2FA code) an account is temporarily locked
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Max. attempts per IP address on login, sign-up, 2FA and password actions
AUTH_RATE_LIMIT_PER_MINUTE=10
AUTH_RATE_LIMIT_PER_HOUR=60
# Max. password reset mail requests per IP address and per email address per hour
PASSWORD_RESET_PER_IP_PER_HOUR=5
PASSWORD_RESET_PER_EMAIL_PER_HOUR=3

# --- Mail server (for "forgot password") ---
# Leave SMTP_HOST empty to disable email.
SMTP_HOST=
# 587 with StartTls, or 465 with SslOnConnect
SMTP_PORT=587
# Auto, StartTls, SslOnConnect or None
SMTP_SECURITY=Auto
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender, e.g. wolsels@example.nl
SMTP_FROM=
SMTP_FROM_NAME=Wolsels

# --- Images ---
# By default the images are pulled from GitHub (ghcr.io), built by GitHub Actions.
REGISTRY=ghcr.io/hjeverts
# latest = newest version. A fixed version (e.g. 1.2.0, or 1.2 for the newest 1.2.x) is set per
# image; then run ./scripts/update.sh. Backend and frontend each have their own version numbers.
TAG=latest
#BACKEND_TAG=1.2.0
#FRONTEND_TAG=1.1.0

# Build from the source repos yourself instead of using ghcr.io (see docker-compose.build.yml):
#COMPOSE_FILE=docker-compose.yml:docker-compose.build.yml
#REGISTRY=wolsels
#BACKEND_CONTEXT=../wolsels_backend
#FRONTEND_CONTEXT=../wolsels_frontend

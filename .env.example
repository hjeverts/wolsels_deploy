# Kopieer naar .env en pas aan. .env staat in .gitignore: zet hier gerust wachtwoorden in,
# maar zorg dat alleen jij het bestand kunt lezen (chmod 600 .env).

# --- Algemeen ---
# Openbare URL, gebruikt voor de links in e-mails
WOLSELS_PUBLIC_URL=https://wolsels.streve.nl
# Poort (op 127.0.0.1) waarop Wolsels luistert; moet gelijk zijn aan proxy_pass in nginx/wolsels.conf
WOLSELS_PORT=8083
# Maximaal aantal soorten wol in één mengsel
MAX_BLEND_COMPONENTS=6

# --- Accounts en beveiliging ---
# Mogen nieuwe gebruikers zelf een account aanmaken? Het allereerste account mag altijd.
ALLOW_REGISTRATION=true
# Na zoveel foute pogingen (wachtwoord of 2FA-code) wordt een account tijdelijk geblokkeerd
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Max. pogingen per IP-adres op inloggen, registreren, 2FA en wachtwoordacties
AUTH_RATE_LIMIT_PER_MINUTE=10
AUTH_RATE_LIMIT_PER_HOUR=60
# Max. aanvragen voor een herstelmail per IP-adres en per e-mailadres per uur
PASSWORD_RESET_PER_IP_PER_HOUR=5
PASSWORD_RESET_PER_EMAIL_PER_HOUR=3

# --- Mailserver (voor "wachtwoord vergeten") ---
# Laat SMTP_HOST leeg om e-mail uit te schakelen.
SMTP_HOST=
# 587 met StartTls, of 465 met SslOnConnect
SMTP_PORT=587
# Auto, StartTls, SslOnConnect of None
SMTP_SECURITY=Auto
SMTP_USERNAME=
SMTP_PASSWORD=
# Afzender, bv. wolsels@example.nl
SMTP_FROM=
SMTP_FROM_NAME=Wolsels

# --- Images ---
# Lokaal bouwen vanuit de broncode-repo's, of een registry gebruiken
REGISTRY=wolsels
TAG=latest
BACKEND_CONTEXT=../wolsels_backend
FRONTEND_CONTEXT=../wolsels_frontend

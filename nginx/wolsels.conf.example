# Voorbeeld-site voor de nginx die op de server draait.
# Kopieer naar /etc/nginx/sites-available/wolsels (of conf.d/wolsels.conf), pas server_name aan,
# en vraag een certificaat aan, bv.: certbot --nginx -d wol.example.nl
#
# De Wolsels-container luistert op 127.0.0.1:8080 (WOLSELS_PORT in .env) en regelt zelf
# de Angular-routes en de doorverwijzing van /api naar de backend.

server {
    listen 80;
    listen [::]:80;
    server_name wol.example.nl;

    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
